// Cloudflare Workers static-assets deploy for the TOPCHeF site, https://topchef.databio.org.
// `.github/workflows/deploy-topchef.yml` builds and deploys it on every push to main that touches
// `ui-topchef/`. The custom domain is bound to the Worker `name`, so it must stay `qtl-browser`.
// The SPA fallback for /gene/... paths
// is `not_found_handling`; a `public/_redirects` with `/* /index.html 200` is rejected by
// Workers as a redirect loop, so there is none.
{
  "name": "qtl-browser",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
