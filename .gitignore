# raw and derived data never go in git; keep the download config and script
data/**
!data/raw/
!data/raw/sources.yaml
!data/raw/download.py

# secrets (bucket credentials for uploading the store)
.env

# Finder metadata
.DS_Store

# python env
.venv/
__pycache__/

# ui apps (ui-topchef is the deployed one, ui the general multi-study fork; each also has its own
# .gitignore covering node_modules and dist)
ui*/node_modules/
ui*/dist/
ui*/bench/out/
ui*/bench/results/

# R / RStudio session files
.Rhistory
.RData
.Rproj.user/
*.Rproj
